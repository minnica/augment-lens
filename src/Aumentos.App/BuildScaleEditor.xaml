<UserControl x:Class="Aumentos.BuildScaleEditor" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aumentos"
             Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary Source="OverlayControls.xaml"/>
    </UserControl.Resources>
    <Border x:Name="Frame" Padding="8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel MinWidth="42" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="PercentText" FontSize="{x:Static local:OverlayPanelStyle.BodySize}" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="SaveStatus" Text="Sin guardar" FontSize="{x:Static local:OverlayPanelStyle.DetailSize}" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Slider x:Name="SizeSlider" Grid.Column="1" Margin="2,0,0,0" Cursor="Hand" Focusable="False" IsTabStop="False"
                    Height="30" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True" TickFrequency="5" SmallChange="5" LargeChange="10"
                    AutomationProperties.Name="Escala del panel en porcentaje"
                    Template="{StaticResource OverlaySlider}"/>
        </Grid>
    </Border>
</UserControl>
