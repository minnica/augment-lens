<UserControl x:Class="Aumentos.BuildScaleEditor" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ControlTemplate x:Key="TrackHitArea" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>
    </UserControl.Resources>
    <Border x:Name="Frame" BorderThickness="1" CornerRadius="4" Padding="8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel MinWidth="42" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="PercentText" FontSize="13" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="SaveStatus" Text="Sin guardar" FontSize="9" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Slider x:Name="SizeSlider" Grid.Column="1" Margin="2,0,0,0" Cursor="Hand" Focusable="False" IsTabStop="False"
                    Height="30" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True" TickFrequency="5" SmallChange="5" LargeChange="10"
                    AutomationProperties.Name="Escala del panel en porcentaje">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Margin="7,0" Height="5" VerticalAlignment="Center" CornerRadius="1"
                                    Background="#050F17" BorderBrush="#A38658" BorderThickness="1"/>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TrackHitArea}"
                                                  Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Cursor="SizeWE" Focusable="False" IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="Handle" Width="11" Height="15" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#E7BF7A" BorderBrush="#765735" BorderThickness="1"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#F6D28C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#FFF0C9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TrackHitArea}"
                                                  Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
        </Grid>
    </Border>
</UserControl>
