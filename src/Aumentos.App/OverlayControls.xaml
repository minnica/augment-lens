<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Aumentos">
    <Style x:Key="OverlayButton" TargetType="Button">
        <Setter Property="Foreground" Value="{x:Static local:OverlayPanelStyle.Ink}"/>
        <Setter Property="Background" Value="{x:Static local:OverlayPanelStyle.Inset}"/>
        <Setter Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.Frame}"/>
        <Setter Property="BorderThickness" Value="{x:Static local:OverlayPanelStyle.FrameThickness}"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static local:OverlayPanelStyle.SelectionSurface}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.SelectionBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static local:OverlayPanelStyle.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverlayComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{x:Static local:OverlayPanelStyle.Ink}"/>
        <Setter Property="Background" Value="{x:Static local:OverlayPanelStyle.Inset}"/>
        <Setter Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.Frame}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{x:Static local:OverlayPanelStyle.Ink}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Item" Background="Transparent" Padding="7,3"
                                        BorderThickness="{x:Static local:OverlayPanelStyle.FrameThickness}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{x:Static local:OverlayPanelStyle.SelectionSurface}"/>
                                        <Setter TargetName="Item" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.SelectionBorder}"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{x:Static local:OverlayPanelStyle.SelectionSurface}"/>
                                        <Setter TargetName="Item" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.SelectionBorder}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDown" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="7,3" IsHitTestVisible="False">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="M 0,0 L 4,4 8,0" Stroke="{x:Static local:OverlayPanelStyle.Gold}"
                                      Margin="5,0,0,0" VerticalAlignment="Center"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                            <Border MinWidth="{TemplateBinding ActualWidth}" BorderThickness="1"
                                    BorderBrush="{x:Static local:OverlayPanelStyle.Frame}" Background="{x:Static local:OverlayPanelStyle.Surface}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static local:OverlayPanelStyle.SelectionSurface}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.SelectionBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="TrackHitArea" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>
    <ControlTemplate x:Key="OverlaySlider" TargetType="Slider">
        <Grid Background="Transparent">
            <Border x:Name="Rail" Margin="9,0" Height="5" VerticalAlignment="Center"
                    Background="{x:Static local:OverlayPanelStyle.Inset}"
                    BorderBrush="{x:Static local:OverlayPanelStyle.Divider}" BorderThickness="1"/>
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource TrackHitArea}"
                                  Focusable="False" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Width="18" Cursor="SizeWE" Focusable="False" IsTabStop="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="Handle" Width="11" Height="15"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{x:Static local:OverlayPanelStyle.Gold}"
                                            BorderBrush="{x:Static local:OverlayPanelStyle.Frame}" BorderThickness="1"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Handle" Property="Background" Value="{x:Static local:OverlayPanelStyle.BrightGold}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Handle" Property="Background" Value="{x:Static local:OverlayPanelStyle.Ink}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource TrackHitArea}"
                                  Focusable="False" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Rail" Property="BorderBrush" Value="{x:Static local:OverlayPanelStyle.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
