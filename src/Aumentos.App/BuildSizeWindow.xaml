<Window x:Class="Aumentos.BuildSizeWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aumentos"
        Title="Tamaño de las builds · Aumentos LoL"
        Width="660" Height="540" MinWidth="370" MinHeight="430" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="OverlayControls.xaml"/>
    </Window.Resources>

    <Grid Margin="22,14,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Text="Tamaño de las builds" FontFamily="{x:Static local:OverlayPanelStyle.Heading}"
                   FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,16">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ScaleLabel" Text="Escala del panel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Foreground="{x:Static local:OverlayPanelStyle.Accent}"
                           FontSize="{x:Static local:OverlayPanelStyle.TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Slider x:Name="SizeSlider" Height="30" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                    TickFrequency="5" SmallChange="5" LargeChange="10" AutomationProperties.Name="Escala del panel en porcentaje" Template="{StaticResource OverlaySlider}"/>
            <DockPanel LastChildFill="False" TextElement.Foreground="{x:Static local:OverlayPanelStyle.Muted}">
                <TextBlock FontSize="{x:Static local:OverlayPanelStyle.DetailSize}" Text="{Binding Minimum, ElementName=SizeSlider, StringFormat={}{0:0} %}"/>
                <TextBlock DockPanel.Dock="Right" FontSize="{x:Static local:OverlayPanelStyle.DetailSize}"
                           Text="{Binding Maximum, ElementName=SizeSlider, StringFormat={}{0:0} %}"/>
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Vista previa" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Border Grid.Row="3" Padding="12" Background="{x:Static local:OverlayPanelStyle.Inset}"
                BorderBrush="{x:Static local:OverlayPanelStyle.Divider}" BorderThickness="1">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid x:Name="PreviewStage">
                    <ContentPresenter x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="True">
            <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="Restablecer 100 %" Style="{StaticResource OverlayButton}" Margin="14,0,0,0"/>
            <TextBlock x:Name="SaveStatus" Foreground="{x:Static local:OverlayPanelStyle.Muted}" FontSize="{x:Static local:OverlayPanelStyle.DetailSize}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Text="Se guarda automáticamente." AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</Window>
