<Window x:Class="Aumentos.BuildSizeButton" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aumentos"
        Title="Tamaño de las builds"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
        Background="Transparent" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="OverlayControls.xaml"/>
    </Window.Resources>
    <Button x:Name="OpenButton" Content="Tamaño…" AutomationProperties.Name="Tamaño de las builds"
            Style="{StaticResource OverlayButton}" Padding="0" Background="{x:Static local:OverlayPanelStyle.Surface}"
            Cursor="Hand" Focusable="False" IsTabStop="False" FontWeight="SemiBold"
            FontFamily="{x:Static local:OverlayPanelStyle.Body}" FontSize="{x:Static local:OverlayPanelStyle.BodySize}"/>
</Window>
