<Window x:Class="Aumentos.BuildSizeButton" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tamaño de las builds"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
        Background="Transparent" UseLayoutRounding="True">
    <Button x:Name="OpenButton" Content="Tamaño…" AutomationProperties.Name="Tamaño de las builds"
            Cursor="Hand" Focusable="False" IsTabStop="False" FontSize="13" FontWeight="SemiBold"
            Foreground="#EEE7D8">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="#1C3940"/>
                        <Setter TargetName="Frame" Property="BorderBrush" Value="#E0BA7A"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="#081923"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
